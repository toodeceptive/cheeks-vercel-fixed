{
  "env": {
    "browser": true,
    "es2021": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "no-console": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_" }],
    "no-undef": "error",
    "semi": ["error", "always"],
    "quotes": ["warn", "double", { "avoidEscape": true }],
    "indent": ["warn", 2],
    "comma-dangle": ["warn", "never"],
    "no-trailing-spaces": "warn",
    "eol-last": ["warn", "always"]
  },
  "globals": {
    "document": "readonly",
    "window": "readonly",
    "navigator": "readonly",
    "fetch": "readonly",
    "FormData": "readonly",
    "URL": "readonly",
    "URLSearchParams": "readonly"
  }
}
